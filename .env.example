# =============================================================================
# SIGMINE Histórico PA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA versione o arquivo .env!
# =============================================================================

# --- Banco de dados PostgreSQL/PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigmine_pa
DB_USER=sigmine_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Flask ---
FLASK_ENV=production
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_32CHARS
FLASK_HOST=0.0.0.0
FLASK_PORT=8001

# --- ETL ---
ANM_PA_URL=https://dadosabertos.anm.gov.br/SIGMINE/PROCESSOS_MINERARIOS/PA.zip
DATA_RAW_DIR=/home/nathan/sigmine-historico-pa/data/raw
LOG_DIR=/home/nathan/sigmine-historico-pa/logs
ETL_SCHEDULE_HOUR=3

# --- Gunicorn (produção) ---
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8001
